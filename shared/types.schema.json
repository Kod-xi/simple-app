{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "Movie": {
            "additionalProperties": false,
            "properties": {
                "adult": {
                    "type": "boolean"
                },
                "backdrop_path": {
                    "type": "string"
                },
                "genre_ids": {
                    "items": {
                        "type": "number"
                    },
                    "type": "array"
                },
                "id": {
                    "type": "number"
                },
                "original_language": {
                    "type": "string"
                },
                "original_title": {
                    "type": "string"
                },
                "overview": {
                    "type": "string"
                },
                "popularity": {
                    "type": "number"
                },
                "poster_path": {
                    "type": "string"
                },
                "release_date": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "video": {
                    "type": "boolean"
                },
                "vote_average": {
                    "type": "number"
                },
                "vote_count": {
                    "type": "number"
                }
            },
            "required": [
                "adult",
                "backdrop_path",
                "genre_ids",
                "id",
                "original_language",
                "original_title",
                "overview",
                "popularity",
                "poster_path",
                "release_date",
                "title",
                "video",
                "vote_average",
                "vote_count"
            ],
            "type": "object"
        },
        "MovieCast": {
            "additionalProperties": false,
            "properties": {
                "actorName": {
                    "type": "string"
                },
                "movieId": {
                    "type": "number"
                },
                "roleDescription": {
                    "type": "string"
                },
                "roleName": {
                    "type": "string"
                }
            },
            "required": [
                "actorName",
                "movieId",
                "roleDescription",
                "roleName"
            ],
            "type": "object"
        },
        "MovieCastResponse": {
            "additionalProperties": false,
            "properties": {
                "cast": {
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "actorName": {
                                "type": "string"
                            },
                            "movieId": {
                                "type": "number"
                            },
                            "roleDescription": {
                                "type": "string"
                            },
                            "roleName": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "actorName",
                            "movieId",
                            "roleDescription",
                            "roleName"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "movie": {
                    "additionalProperties": false,
                    "properties": {
                        "genre_ids": {
                            "items": {
                                "type": "number"
                            },
                            "type": "array"
                        },
                        "overview": {
                            "type": "string"
                        },
                        "title": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "genre_ids",
                        "overview",
                        "title"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "cast"
            ],
            "type": "object"
        }
    }
}